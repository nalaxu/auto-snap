# 复制为 .env 并填写（.env 不会入库）
# OpenAI 官方：OPENAI_BASE_URL 留空；第三方中转 / 兼容 OpenAI 协议的厂商：填其 Base URL（通常以 /v1 结尾）
OPENAI_API_KEY=
OPENAI_BASE_URL=

# 若 config/settings.toml 中 llm.provider = "anthropic"
ANTHROPIC_API_KEY=

# 可选：DeepSeek（config/settings.toml 中 llm.profile = "deepseek" 时使用）
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
